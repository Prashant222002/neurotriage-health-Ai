{
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/billing?p=/:path*" },
    { "source": "/api/create-order", "destination": "/api/billing?p=/create-order" },
    { "source": "/api/verify-payment", "destination": "/api/billing?p=/verify-payment" },
    { "source": "/((?!api/|.well-known/).*)", "destination": "/index.html" }
  ]
}
